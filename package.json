{
  "name": "lumina-edit-pro",
  "private": true,
  "version": "1.1.2",
  "description": "Local-first AI Markdown workspace - Powered by codywon",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3188 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
    "lint": "tsc --noEmit",
    "test": "vitest run --environment jsdom",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build --no-bundle && node -e \"const fs=require('fs'); fs.copyFileSync('src-tauri/target/release/lumina-edit-pro.exe', 'src-tauri/target/release/Lumina-Edit-Pro.exe'); fs.copyFileSync('src-tauri/target/release/lumina-edit-pro.exe', 'Lumina-Edit-Pro.exe'); fs.copyFileSync('src-tauri/target/release/lumina-edit-pro.exe', 'src-tauri/target/debug/lumina-edit-pro.exe');\"",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build --no-bundle && node -e \"const fs=require('fs'); fs.copyFileSync('src-tauri/target/release/lumina-edit-pro.exe', 'src-tauri/target/release/Lumina-Edit-Pro.exe'); fs.copyFileSync('src-tauri/target/release/lumina-edit-pro.exe', 'Lumina-Edit-Pro.exe'); fs.copyFileSync('src-tauri/target/release/lumina-edit-pro.exe', 'src-tauri/target/debug/lumina-edit-pro.exe');\""
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
