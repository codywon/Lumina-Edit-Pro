    "framer-motion": "^12.35.1",
    "html-to-image": "^1.11.13",
    "katex": "^0.18.7",
    "lowlight": "^3.3.0",
    "lucide-react": "^0.546.0",
    "marked": "^12.0.2",
    "mermaid": "^12.0.0",
    "motion": "^12.23.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.5.0",
    "tiptap-markdown": "^0.9.0",
    "vite": "^6.2.0"
